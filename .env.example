# 指向「現有 DMS 平台同一個 Postgres」——本服務讀 repair_income / revenue_targets，
# 寫 revenue_budget_plan。
POSTGRES_CONNECTION_STRING=postgres://USER:PASSWORD@HOST:5432/DBNAME

# TLS 模式（預設 false=關閉；雲端 DB 多半用 require）
#   false / disable  關閉
#   require / true   開啟、接受自簽憑證
#   strict / verify  開啟、嚴格驗證憑證鏈
POSTGRES_SSL=false

# 服務埠（預設 3000）
PORT=3000
